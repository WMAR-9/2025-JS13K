{
  "name": "blackcat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "rm -fr ./dist && vite build",
    "preview": "vite preview",
    "test":"node ./src/js/main.js",
    "zip": "node ./tools/zip.js && bash ./tools/zip.sh",
    "deploy": "git add . && git commit -m \"New push \" && git push",
    "page": "git add -f black_cat/dist && git commit -m \"New build\" && git push && git subtree push --prefix=black_cat/dist/blackcat origin gh-pages"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "node": "^22.17.0",
    "terser": "^5.43.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^2.0.0",
    "vite-plugin-imagemin": "^0.4.0"
  }
}
